; Файл настроек проекта Godot 4.5

config_version=5

[application]

config/name="Dungeon Castle"
config/description="Castle builder with an endless dungeon below"
config/version="0.2.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.164706, 0.121569, 0.113725, 1)
boot_splash/show_image=false

[autoload]

DB="*res://scripts/autoload/data_db.gd"
GameState="*res://scripts/autoload/game_state.gd"
SaveSystem="*res://scripts/autoload/save_system.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=2340
window/size/window_width_override=432
window/size/window_height_override=936
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/translations=PackedStringArray("res://data/i18n/strings.en.translation", "res://data/i18n/strings.ru.translation")
locale/fallback="en"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/canvas_textures/default_texture_filter=3
environment/defaults/default_clear_color=Color(0.164706, 0.121569, 0.113725, 1)
